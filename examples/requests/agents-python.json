{
  "tenant_id": "ci",
  "context": {"source": "inline", "project_name": "agents-service", "package_name": "agents_service",
              "runtime": "python", "runtime_version": "3.12", "build_tool": "poetry", "platform": "gcp",
              "project_type": "fastapi_microservice"},
  "harness": {
    "generator_type": "e2a_inherited",
    "e2a_contract": "1.2",
    "agents": [
      {"name": "RouterAgent", "kind": "model",
       "output_schema": {"type": "object", "required": ["intent"],
                         "properties": {"intent": {"enum": ["ORDER", "STATUS"]}}}},
      {"name": "OrderAgent", "kind": "deterministic", "reads": ["get_price"], "writes": ["submit_payment"]},
      {"name": "StatusAgent", "kind": "model", "reads": ["get_order"]}
    ],
    "workflow": {"name": "OrderWorkflow", "steps": [
      {"step": "route", "agent": "RouterAgent"},
      {"step": "act", "route_by": "intent", "agents": {"ORDER": "OrderAgent", "STATUS": "StatusAgent"},
       "material": true}
    ]},
    "governance": {"stages": ["capacity", "token_budget", "firewall", "approval", "redaction"]}
  },
  "prompt": {"user_prompt": "Orders and order status, as three agents in one workflow."},
  "a2c_sdlc": {"enabled": true, "project_type": "FastAPI Microservice", "target_cloud": "gcp",
               "mandatory_nfrs": ["Audit"]}
}
