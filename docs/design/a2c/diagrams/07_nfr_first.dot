digraph G {
  graph [rankdir=TB, fontname="DejaVu Sans", fontsize=13, labelloc=t, label=<<b>NFR-first generation order (a2c_sequence = nfr_first, default)</b>>, fontcolor="#1F3864", nodesep=0.3, ranksep=0.2, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#F4F8FC", color="#1F3864", fontname="DejaVu Sans", fontsize=10.5, fontcolor="#1F3864", margin="0.12,0.05", width=5.4];
  edge [color="#2E4A6B"];
  p1 [label="1  RequirementsAgent — spec, TypedDict schema, NFR list, layer map"];
  p2 [label="2  IaCAgent — compute, load balancer, queue + DLQ, search, secrets, network"];
  p3 [label="3  CodeGenAgent (observability) — JSON logs, tracing, metrics, SLO checker"];
  p4 [label="4  CICDAgent — OIDC, eval gate, image scan, deploy, auto-rollback"];
  p5 [label="5  CodeGenAgent (NFRs) — circuit breakers, retry, FinOps routing, policy-as-code"];
  p6 [label="6  CodeGenAgent (business logic) — agents, RAG, tools, routers, workflow"];
  p7 [label="7  CodeCriticAgent — NFR patterns, layers, score ≥ 0.75", fillcolor="#E6F4F5", color="#0F7C8C"];
  p1->p2->p3->p4->p5->p6->p7;
}
