digraph G {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=13, labelloc=t, label=<<b>Inherited generators — internal phases mapped onto the 12-step sequence</b>>, fontcolor="#1F3864", nodesep=0.3, ranksep=0.35, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#F4F8FC", color="#1F3864", fontname="DejaVu Sans", fontsize=10.5, fontcolor="#1F3864", margin="0.12,0.06"];
  edge [color="#2E4A6B"];
  a [label="Setup\n1–4 (base)\nresolve · validate ·\npolicy · claim"];
