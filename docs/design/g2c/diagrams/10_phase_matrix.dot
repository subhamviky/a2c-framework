<tr><td><b>2A</b></td><td>Reuse</td><td>New</td><td bgcolor="#EEEEEE">Skip</td><td bgcolor="#EEEEEE">Skip</td><td bgcolor="#E3F1E3">Run</td><td bgcolor="#E3F1E3">Run</td><td bgcolor="#E3F1E3">Run</td><td bgcolor="#DCE8F5">Generate fresh</td><td bgcolor="#E3F1E3">Run</td></tr>
