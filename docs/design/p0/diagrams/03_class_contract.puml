  +bootstrap(request, config=None, **kw) : ScaffoldResult
  ..abstract hooks..
  #_validate_request(request, config, **kw) : bool
  #_plan_scaffold(request, config, **kw) : List[dict]
  #_scaffold_structure(request, config, project_root, **kw)
  #_generate_build_manifest(request, config, **kw) : str
  #_generate_git_config(request, config, **kw) : Dict[str, str]
  #_generate_env_templates(request, config, **kw) : Dict[str, str]
  #_generate_readme_scaffold(request, config, **kw) : str
  #_generate_docker_config(request, config, **kw) : Dict[str, str]
  ..protected defaults..
  #_resolve_config(request, config, **kw) : ScaffoldRequest
